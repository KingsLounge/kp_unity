protocol PCProtocol
{
	struct PC_ACCOUNT_BLOCKED				# 설명 : 관리자에 의해 계정 블록
	{
		wchar[STRING_64_LEN+1] 				text;
		char[DATETIME_LEN+1]				active;
		char[DATETIME_LEN+1]				expire;
	}
	
	struct PC_KICK							# 설명 : 나가
	{
		int						reason;
	}
	
	struct PC_CONSOLE_LOGIN_SUCCESS	{
		bool 					success;
        char[STRING_32_LEN+1] 	token;
        char[STRING_32_LEN+1] 	uid;
		wchar[STRING_32_LEN+1] 	nick;
		int 					status;
	}
	struct PC_CONSOLE_LOGIN_FAIL {
		int 					reason;
	}
	struct PC_CONSOLE_USERINFO	{		# {"success":true,"uid":"aaa001","umoney":0,"token":"631031C9D39A8E952EC0"}
		bool 					success;
        char[STRING_32_LEN+1] 	token;
        char[STRING_32_LEN+1] 	uid;
		wchar[STRING_32_LEN+1] 	nick;
		int 					status;
		int 					type;		# 0 = 일반유저  1 = 딜러
		char[STRING_4_LEN+1] 	currency;
		long					gc;
		long					sc;
	}

	struct PC_OBSERVER_ENTER{
		char[STRING_16_LEN+1] 	game_type;
		int 					gtn;
		int 					dn;
	}
	struct PC_OBSERVER_EXIT{
		int 					gtn;
		int 					dn;
	}

	struct PC_USER_TRANSFER_GCSC{
		char[ STRING_8_LEN+1] 	transfertype;
		int 					amount;
		long 					gc;
		long 					sc;
	}
	struct PC_USER_TRANSFER_GCSC_FAIL{
		int 					code;
		wchar[STRING_32_LEN+1] 	reason;
	}
	struct PC_USER_INFO_UPDATE{
		char[STRING_32_LEN+1] 	gid;
		wchar[STRING_32_LEN+1] 	nick;
		int 					icon;
		long 					gc;
		long 					sc;
	}

	struct PC_USER_TOKEN_UPDATE{
		int 					reason;
	}

	struct PC_PING{
	}

	struct PC_SET_NOTIFICATION{
		int 						ecode;
		push   						o;
	}

    struct PC_USER_GAMEINFO{
        gameinfo                info;
    }

    struct PC_USER_QUESTINFO{
        questinfo               info;
    }

    struct PC_QUEST_LIST{
        questlist               list;
    }

	struct PC_QUEST_CLEAR{
        item                            update;
	}

    struct PC_QUEST_CLEAR_FAIL{
        int                             code;
		wchar[STRING_32_LEN+1] 			reason;
	}

    struct PC_RANKING{
        ranking  		list;
    }

    struct PC_USER_INFO_OPTION_UPDATE{
        optionData updateData;
    }

    struct PC_USER_INFO_OPTION_UPDATE_FAIL{
        int                             code;
		wchar[STRING_32_LEN+1] 			reason;
    }

    struct PC_USER_NOTIFICATION{
        int                             code;
		wchar[STRING_32_LEN+1] 			message;
        char[STRING_32_LEN+1] 	gid;
    }

    struct PC_USER_DAILY_LOSS_LIMIT_UPDATE{
        bool 					success;
    }

    struct PC_USER_DAILY_LOSS_LIMIT_UPDATE_FAIL{
        int                             code;
		wchar[STRING_32_LEN+1] 			reason;
