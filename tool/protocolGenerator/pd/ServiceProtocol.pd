protocol CPProtocol
{
	# 설명: 로그아웃 요청 
	struct CP_LOGOUT {
		int why;
	}
		
	struct CP_CONSOLE_LOGIN{						# 설명 : 콘솔 버전  로그인 
		char[STRING_8_LEN+1] 		os ;				# web, android, ios
		char[STRING_8_LEN+1] 		browser;			# web, android, ios  exp
		char[STRING_8_LEN+1] 		client_type;		# basic, 

		bool						isObserver;
		char[STRING_32_LEN+1] 		streamerUid;

