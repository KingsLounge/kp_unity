
typedef UserNumType = int;
typedef MoneyType = LONGLONG;


[NoPrefix]

enum KICK_REASON
{
	UNKNOWN=0,					
	JUST_KICK=1,					# 이유는 없지만 그냥 종료시키고 싶을때
	ANOTHER_LOGIN=2,				# 또다른 로그인이 일어난 경우
	BLOCK=3,						# 계정을 블럭 합니다. 
	GAMEMONEY_LOSE_LIMIT=4,	   	# 게임 머니 소진량 초과
	USER_LOGOUT=5,				# 유저에의한 로그아웃(  옵션메뉴에서 로그아웃을 눌렀다 )
	NETWORK_STOP = 6,
}

enum USER_TYPE
{
    PLAYER = 0,
    DEALER = 1,
    OBSERVER = 2,
    UNSEATED = 3,   	# gameTable에 들어왔지만 아직 자리에 앉지 못했다. 아마도 다음 게임에 자리에 앉게 될 듯.
    BOT = 4,
    BREAK_TIME = 5, 	# 플레이 도중에, 잠시 자리를 비웠다. 
}

