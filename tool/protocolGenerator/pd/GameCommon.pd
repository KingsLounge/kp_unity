enum ROOM_COMMAND 
{
	none   				= 0,
	just_room_created  	= 5,
	waiting_player = 10,			# 플레이어가 들어오길 기다린다. 
	ready_to_start = 15,			# 시작을 준비한다. 
	wait_to_start_button = 16,		# 딜러의 스타트 버튼을 기다린다. 
	check_to_start = 17, 			# 딜러가 스타트 버튼을 눌렀다. 체크할거 있으면 다시 체크하자. 
	start = 20,						# 게임시작. 
	playing = 22,					# 게임중  
	make_results = 25,
	calc_dividend = 30,				# 여기서  __POKER_GAMERESULT 를 보낸다. 

	auto_rebuy_free_chip = 31,		# ( if tm == 0 ) 오토 리바이 또는 무료충전 

	dividend_check = 35,

	donation = 36,
	break_time  = 37,


	check_new_members = 40, 		# 나가는 유저와 새로 들어온 유저를 체크한다. 

	check_tournament_deal = 41,		# 토너먼트 딜 확인

	end = 49,
}
