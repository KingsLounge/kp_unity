MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8383659163588817605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: eb0be175fcf4b2c44ab4df8a70c66065, type: 3}
    m_FontSize: 84
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 7
    m_MaxSize: 84
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uCC39\uC740 \uC5B4\uB5BB\uAC8C \uC9C4\uD589\uB418\uB098\uC694?\r\n\n\uBAA8\uB4E0
    \uD50C\uB808\uC774\uC5B4\uB294 \uBA3C\uC800 \uAC70\uB798\uB97C \uD558\uB294 \uB370
    \uB3D9\uC758\uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\n\n\u2022 \uADF8\uB7F0 \uB2E4\uC74C
    \uAC8C\uC784\uC740 \uC7A0\uC2DC \uC911\uB2E8\uB418\uC5B4 \uAC01 \uD50C\uB808\uC774\uC5B4\uAC00
    \uC18C\uC720\uD55C \uCE69 \uC2A4\uD0DD\uC5D0 \uB530\uB77C \uBD84\uBC30\uB420
    \uC0C1\uAE08 \uAE08\uC561\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.\r\n\n\u2022 \uBAA8\uB4E0
    \uD50C\uB808\uC774\uC5B4\uAC00 \uC774 \uC0C1\uAE08 \uBD84\uBC30\uC5D0 \uB3D9\uC758\uD574\uC57C\uB9CC
    \uAC70\uB798\uAC00 \uC644\uB8CC\uB429\uB2C8\uB2E4.\r\n\n\u2022 \uC0C1\uAE08 \uBD84\uBC30\uB97C
    \uACB0\uC815\uD558\uB294 \uB370 \uC0AC\uC6A9\uB418\uB294 \uBC29\uBC95\uC740 \uB3C5\uB9BD
    \uCE69 \uBAA8\uB378(ICM)\uC785\uB2C8\uB2E4.\r\n\n\u2022 ICM\uC744 \uC801\uC6A9\uD558\uBA74
    \uCE69 \uC2A4\uD0DD\uC5D0 \uB530\uB77C \uC0C1\uAE08\uC774 \uC815\uD655\uD558\uAC8C
    \uACC4\uC0B0\uB418\uC5B4 \uC0C1\uAE08\uC758 \uACF5\uC815\uD55C \uBD84\uBC30\uAC00
    \uBCF4\uC7A5\uB429\uB2C8\uB2E4."
