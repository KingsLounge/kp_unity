+    public void updatePlayGamePlayerCount(JObject c)
+    {
+        
+        JObject json = c;
+        long gtn = (long)json["gtn"];
+        int  playerCount = (int)json["player_count"];
+
+        var playGameItem= playGameItemList.Find((PlayGameItem i)=>{return (long)i.playGameInfo.info["gtn"]== gtn;});
+        if(playGameItem!= null)
+        {
+            playGameItem.updatePlayerCount(playerCount);
+        }
+    }
