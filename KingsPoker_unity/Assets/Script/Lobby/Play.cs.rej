+    public void ReceivePlayGameList(JObject c)
+    {
+        int ecode = (int)c["ecode"];
+        //int page= (int)c["page"];
+        //int per= (int)c["per"];
+        //string orderColumn = (string)c["orderColumn"];
+        //string orderDir= (string)c["orderDir"];
+        //int total= (int)c["total"];
+        //int totalFilter= (int)c["totalFiltered"];
+        JObject[] temp_playGameInfoList = JsonDataParser.Parse<JObject[]>(c["playGameList"]);
+
+        // 일단 모두 지우고 
+        if (playGameInfoList== null)
+        {
+            playGameInfoList= new List<PlayGameInfo>();
+        }
+        else
+        {
+            playGameInfoList.Clear();
+        }
+
+        if (playGameItemList == null)
+        {
+            playGameItemList= new List<PlayGameItem>();
+        }
+
+        // 게임 리스트 모두 삭제 
+        while (0 < playGameItemList.Count)  
+        {
+            var m = playGameItemList[playGameItemList.Count-1];
+            playGameItemList.RemoveAt(playGameItemList.Count-1);
+            // Destroy(m.gameObject);
+        }
+
+        // 다른것이 있으면 모두 삭제 
+        while (contentContainer.transform.childCount != 0)
+        {
+            var child = contentContainer.transform.GetChild(0);
+            child.SetParent(null);
+            Destroy(child.gameObject);
+        }
+
+        Instantiate(prefab_EventItem, contentContainer);
+
+        for (int i = 0; i < temp_playGameInfoList.Length; i++)
+        {
+            var temp_playInfo = temp_playGameInfoList[i];
+            Debug.Log(temp_playInfo);
+
+            
+            PlayGameInfo playInfo = new PlayGameInfo(temp_playInfo);
+            playGameInfoList.Add(playInfo);
+
+            PlayGameItem ci = Instantiate(prefab_PlayGameItem, contentContainer).GetComponent<PlayGameItem>();
+            ci.manager = this;
+            ci.Set(playInfo);
+            playGameItemList.Add(ci);
+        }
+    }
